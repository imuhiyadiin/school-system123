// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  CASHIER

  User
}

enum ExamType {
  QUIZ
  MONTHLY
  MIDTERM
  THIRD
  FINAL
}

enum PayrollStatus {
  PENDING
  PAID
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  password    String
  role        Role
  permissions String[] @default([])
  isActive    Boolean  @default(true)

  teacher      Teacher?
  admin        Admin?
  cashier      Cashier?
  settings     Setting?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Admin {
  id          String @id @default(cuid())

  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String
}

model Teacher {
  id          String @id @default(cuid())

  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String
  gender      String
  dob         DateTime
  phone       String?
  address     String?
  joinedAt    DateTime @default(now())
  password    String
  basicSalary Float    @default(0)
  allowance   Float    @default(0)
  subjects    TeacherSubject[]
  arrivalTime String?
  classrooms  Classroom[]
  payrolls    Payroll[]
  attendances TeacherAttendance[]
}

model employee {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  fullName      String
  email         String   @unique
  phone         String?
  gender        String?
  dob           DateTime?
  address       String?
  position      String
  department    String
  joinedAt      DateTime @default(now())
  basicSalary   Float    @default(0)
  allowance     Float    @default(0)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payrolls      Payroll[]

  @@map("Staff")
}


model Payroll {
  id            String        @id @default(cuid())
  teacherId     String?
  teacher       Teacher?      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staffId       String?
  staff         employee?        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  basicSalary   Float
  allowance     Float         @default(0)
  deduction     Float         @default(0)
  advance       Float         @default(0)
  netSalary     Float
  status        PayrollStatus @default(PENDING)
  paymentDate   DateTime?
  paymentMethod String?
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([teacherId, month, year])
  @@unique([staffId, month, year])
  @@index([month, year])
}

model Cashier {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
}



model Student {
  id              String @id @default(cuid())
  studentID       String? @unique

  fullName        String
  password         String
  gender          String
  dob             DateTime 
  phone           String?
  address         String?
  parentName      String?
  parentPhone     String?
  totalFee        Float    @default(0)
  status          String   @default("ACTIVE")
  busId           String?
  bus             Bus?     @relation(fields: [busId], references: [id], onDelete: SetNull)
  admissionDate   DateTime @default(now())

  classrooms      ClassroomStudent[]
  attendances     Attendance[]
  results         Result[]
  issues          Issue[]
  payments        Payment[]
}

model Classroom {
  id          String @id @default(cuid())

  name        String
  section     String
  grade       Int

  teacherId   String
  teacher     Teacher @relation(fields: [teacherId], references: [id])

  students    ClassroomStudent[]
  timetable   Timetable[]
  results     Result[]
  issues      Issue[]
  attendances Attendance[]
}

model ClassroomStudent {
  classroomId String
  studentId   String

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classroomId, studentId])
}

model Subject {
  id            String @id @default(cuid())

  name          String
  grade         Int
  description   String?

  results       Result[]
  exams         Exam[]
  teachers      TeacherSubject[]
}

model TeacherSubject {
  teacherId String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model Exam {
  id          String @id @default(cuid())

  name        String
  date        DateTime
  type        ExamType
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  total       Int     @default(100)
  minMarks    Int     @default(33)
  results     Result[]
}

model Result {
  id          String @id @default(cuid())

  studentId   String
  classId     String?
  subjectId   String
  examId      String
  schoolYear  String?

  marks       Int

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom   Classroom? @relation(fields: [classId], references: [id], onDelete: SetNull)
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  exam        Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Attendance {
  id          String @id @default(cuid())

  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  date        DateTime
  status      String   @default("PRESENT")
  remark      String?
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
}

model TeacherAttendance {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String   @default("PRESENT")
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, date])
  @@index([date])
}

model Timetable {
  id            String @id @default(cuid())

  classroomId   String
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  day           String
  time          String
  subject       String
}

model Issue {
  id            String @id @default(cuid())

  studentId     String
  classId       String?
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom     Classroom? @relation(fields: [classId], references: [id], onDelete: SetNull)

  type          String
  details       String
  isResolved    Boolean @default(false)
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolName String? 
  timezone   String?
  updatedAt DateTime @updatedAt
}

model Payment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentDate DateTime
  paymentMode String
  amount      Float
  reference   String?
  note        String?
  createdAt   DateTime @default(now())
}

model Fee {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bus {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  vehiclePlate String?
  location     String
  arrivalTime  String?
  students     Student[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
